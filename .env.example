# Copy this file to .env and fill in real values.
#
# This is the ONLY .env file this project needs — there's no separate
# backend server anymore. Backend logic runs as Supabase Edge Functions,
# and their secrets are set separately via the Supabase CLI/dashboard
# (never in a file in this repo) — see the "Edge Functions" section in
# README.md.
#
# Everything below is safe to expose in the browser bundle: the Supabase
# anon key only grants what Row Level Security (supabase/schema.sql)
# allows, and Stripe's publishable key is meant to be public.

# ---------- Supabase (required - the app has no data without this) ----------
# Get these from your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------- Stripe (optional - card checkout won't work without it) ----------
# Get it from https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
