# Edge Function secrets. Copy to supabase/functions/.env (git-ignored),
# fill in, then push them all at once:
#
#   supabase secrets set --env-file supabase/functions/.env
#
# `supabase functions serve` also reads this file automatically for local
# testing. NEVER put these in the frontend .env - nothing here is safe in
# a browser bundle.
#
# Anything left blank just switches that feature off; the site keeps
# working (bookings save, WhatsApp buttons still work, saved reviews and
# Instagram posts still show).

# ---------- Stripe ----------
# https://dashboard.stripe.com/apikeys (sk_test_... while testing, sk_live_... for real)
STRIPE_SECRET_KEY=
# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends shoppers back to after paying
CLIENT_URL=http://localhost:5173
# Optional: pin payment methods (comma list, e.g. card,link). Leave blank to
# offer every method enabled in Dashboard -> Settings -> Payment methods.
STRIPE_PAYMENT_METHOD_TYPES=
# Optional: true to show a promo-code box at checkout
STRIPE_ALLOW_PROMOTION_CODES=false
# Optional: true to email a PDF invoice with each payment (Stripe Invoicing fees apply)
STRIPE_INVOICES=false

# ---------- Email (Gmail SMTP) ----------
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CLINIC_NOTIFY_EMAIL=info@pearlaestheticgp.com

# ---------- WhatsApp Cloud API (booking/order alerts to the clinic) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CLINIC_WHATSAPP_NUMBER=971559639972
# Approved template names (recommended - plain text only delivers inside
# WhatsApp's 24-hour window). See README "WhatsApp alerts".
WHATSAPP_BOOKING_TEMPLATE=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ---------- Instagram (live gallery / results / facilities) ----------
INSTAGRAM_ACCESS_TOKEN=

# ---------- Google reviews (Places API New) ----------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJickRNwBtXz4RtS60CfrdqnY
